{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YASGM",
  "version": "0.1.0",
  "identifier": "dev.yasgm.ui",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:sidecar",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YASGM",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yasgm"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRTU3OERENjA4NDJCNEYKUldSUEs0UmczWGpsNzY3c2JKZVRLbE5reDkxL3dvTWpNdnRjNnpaU0tIZnkrMlh3Smw0Zk9VSXQK",
      "endpoints": [
        "https://github.com/viktor-malieichyk/yasgm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
